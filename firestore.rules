rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && orgId != null && (
        // 1. Check if user is the Owner of the organization (Direct check in Org doc)
        (exists(/databases/$(database)/documents/organizations/$(orgId)) && 
         get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid) ||
        // 2. Check User Profile (OrgIds list - Source of Truth)
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         orgId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgIds', []))
      );
    }
    
    function isOrgOwner(orgId) {
      return isAuthenticated() && orgId != null &&
             exists(/databases/$(database)/documents/organizations/$(orgId)) && 
             get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    function resourceBelongsToUserOrg() {
      // CEL FIX: Use proper existence checks instead of || on strings
      return isAuthenticated() && (
        ('orgId' in resource.data && isOrgMember(resource.data.orgId)) ||
        ('organizationId' in resource.data && isOrgMember(resource.data.organizationId)) ||
        ('orgID' in resource.data && isOrgMember(resource.data.orgID))
      );
    }

    function requestBelongsToUserOrg() {
      // CEL FIX: Same for request data
      return isAuthenticated() && (
        ('orgId' in request.resource.data && isOrgMember(request.resource.data.orgId)) ||
        ('organizationId' in request.resource.data && isOrgMember(request.resource.data.organizationId)) ||
        ('orgID' in request.resource.data && isOrgMember(request.resource.data.orgID))
      );
    }

    // --- Public Access Rules (Preview & Onboarding) ---
    
    match /invites/{inviteId} {
       allow read: if isAuthenticated(); 
       allow create, update: if isAuthenticated();
    }

    match /organizations/{orgId} {
      allow get: if true; 
      allow list, create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOrgMember(orgId) || isOrgOwner(orgId) || (request.auth.uid in resource.data.memberIds) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds']));
      allow delete: if isAuthenticated() && isOrgOwner(orgId);

      match /settings/{settingDoc} {
        allow read: if isAuthenticated() && isOrgMember(orgId);
        allow write: if isAuthenticated() && isOrgOwner(orgId);
      }

      match /posts/{postId} {
        allow read: if isAuthenticated() && isOrgMember(orgId);
        allow create: if isAuthenticated() && isOrgMember(orgId);
        allow update: if isAuthenticated() && isOrgMember(orgId) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount', 'reactions'])) ||
          (resource.data.author.id == request.auth.uid || isOrgOwner(orgId))
        );
        allow delete: if isAuthenticated() && (resource.data.author.id == request.auth.uid || isOrgOwner(orgId));
        
        match /comments/{commentId} {
            allow read: if isAuthenticated() && isOrgMember(orgId);
            allow create: if isAuthenticated() && isOrgMember(orgId);
            allow update, delete: if isAuthenticated() && (resource.data.author.id == request.auth.uid || isOrgOwner(orgId));
        }
      }
    }

    // --- Authenticated Resource Rules ---

    match /users/{userId} {
      allow read: if isAuthenticated(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizations', 'orgIds', 'teamIds', 'organizationIds']));
      allow delete: if isOwner(userId);

      match /orgSettings/{orgId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /projects/{projectId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg() && isOrgOwner(resource.data.orgId);
    }
    
    function isOrgStaffOrHigher(orgId) {
      // Fallback: If they are a member, they are treated as staff for now to unblock
      return isOrgMember(orgId);
    }

    match /tasks/{taskId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg() || (
        // Allow migration: Check if only `orgId` is being added/updated and the project belongs to the user's org
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orgId']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orgId', 'updatedAt'])
      );
      allow delete: if resourceBelongsToUserOrg();
    }

    match /works/{workId} {
      allow read: if isAuthenticated() && isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && isOrgStaffOrHigher(request.resource.data.orgId);
      allow update: if isAuthenticated() && isOrgStaffOrHigher(resource.data.orgId);
      allow delete: if isAuthenticated() && isOrgStaffOrHigher(resource.data.orgId);
    }

    match /incomes/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }

    match /expenses/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }
    
    match /customers/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }
    
    match /vendors/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }

    match /files/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }
    
    match /contracts/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }
    
    match /workers/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }

    match /notifications/{notificationId} {
      allow read: if resourceBelongsToUserOrg(); 
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && request.auth.uid == (resource.data.userId || resource.data.createdBy);
    }

    match /game_scores/{scoreId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    match /activities/{activityId} {
        allow read: if resourceBelongsToUserOrg();
        allow create: if requestBelongsToUserOrg();
    }

    match /join_requests/{requestId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOrgMember(resource.data.orgId));
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOrgOwner(resource.data.orgId));
    }

    match /chat_threads/{threadId} {
        allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
        
        match /messages/{messageId} {
            allow read, write: if isAuthenticated() && (
               request.auth.uid in get(/databases/$(database)/documents/chat_threads/$(threadId)).data.participants
            );
        }
    }

    match /integrations/{docId} {
      allow read: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
      allow update: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow delete: if isAuthenticated() && isOrgMember(resource.data.organizationId);
    }
  }
}
