rules_version = '2'; // Force deploy 2026-01-19

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Default: Deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow authenticated users to create/update users (needed for Admin/Owner to manage others)
      allow create, update: if isAuthenticated();
      // Allow delete if authenticated (Admin/Owner deletion handled by UI logic mostly, rule can be strict or loose)
      allow delete: if isAuthenticated(); 
    }

    // Organizations (Teams)
    match /organizations/{orgId} {
      allow read: if isAuthenticated(); // Refine: check if user is in 'members' array
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Refine: check if user is admin
      allow delete: if isAuthenticated(); // Refine: check if user is owner
    }

    // Projects
    match /projects/{projectId} {
      allow read, write: if isAuthenticated(); // Simplify for now, ideally check org membership
    }
    
    // Activities
    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    // Customers, Incomes, Expenses - access via Org
    match /customers/{docId} { allow read, write: if isAuthenticated(); }
    match /incomes/{docId} { allow read, write: if isAuthenticated(); }
    match /expenses/{docId} { allow read, write: if isAuthenticated(); }
    match /files/{docId} { allow read, write: if isAuthenticated(); }
    match /tasks/{docId} { allow read, write: if isAuthenticated(); }
    match /vendors/{docId} { allow read, write: if isAuthenticated(); }
    match /wages/{docId} { allow read, write: if isAuthenticated(); }
    // Invitations
    match /invites/{inviteId} { allow read, write: if isAuthenticated(); }

    // Workers & Contracts
    match /workers/{workerId} { allow read, write: if isAuthenticated(); }
    match /contracts/{contractId} { allow read, write: if isAuthenticated(); }
    
    // Notifications
    match /notifications/{notificationId} { allow read, write: if isAuthenticated(); }
  }
}
