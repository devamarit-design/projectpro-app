rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(path) ? get(path).data : null;
    }

    function isOrgMember(orgId) {
      let data = getUserData();
      return isAuthenticated() && (
        (data != null && (
          ('orgIds' in data && orgId in data.orgIds) ||
          ('teamIds' in data && orgId in data.teamIds) ||
          ('organizations' in data && data.organizations.any(o => o.orgId == orgId))
        )) || 
        // Fallback: Check org document directly if user doc sync is slow
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.members.any(m => m.userId == request.auth.uid)
      );
    }
    
    function getMemberRole(orgId) {
       let orgPath = /databases/$(database)/documents/organizations/$(orgId);
       let members = exists(orgPath) ? get(orgPath).data.members : [];
       let member = members.filter(m => m.userId == request.auth.uid);
       return member.size() > 0 ? member[0].role : null;
    }

    function isOrgOwner(orgId) {
      let path = /databases/$(database)/documents/organizations/$(orgId);
      return isAuthenticated() && exists(path) && (
        get(path).data.ownerId == request.auth.uid || 
        getMemberRole(orgId) == "Owner"
      );
    }

    function isOrgAdminOrOwner(orgId) {
      let role = getMemberRole(orgId);
      return isAuthenticated() && (role == "Owner" || role == "Admin");
    }

    function resourceBelongsToUserOrg() {
      return isAuthenticated() && (
        (resource.data.orgId != null && isOrgMember(resource.data.orgId)) ||
        (resource.data.organizationId != null && isOrgMember(resource.data.organizationId))
      );
    }

    function requestBelongsToUserOrg() {
      return isAuthenticated() && (
        (request.resource.data.orgId != null && isOrgMember(request.resource.data.orgId)) ||
        (request.resource.data.organizationId != null && isOrgMember(request.resource.data.organizationId))
      );
    }

    // --- Public Access Rules (Preview & Onboarding) ---
    
    match /invites/{inviteId} {
       allow get: if true; 
       allow list: if false; // Enumeration protection
       allow create, update: if isAuthenticated(); // Simplified for now to unblock
    }

    match /organizations/{orgId} {
      allow get: if true; 
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOrgMember(orgId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']));
      allow delete: if isAuthenticated() && isOrgOwner(orgId);

      match /settings/{settingDoc} {
        allow read: if isAuthenticated() && isOrgMember(orgId);
        allow write: if isAuthenticated() && isOrgAdminOrOwner(orgId);
      }

      match /posts/{postId} {
        allow read: if isAuthenticated() && isOrgMember(orgId);
        allow create: if isAuthenticated() && isOrgMember(orgId);
        allow update: if isAuthenticated() && isOrgMember(orgId) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount'])) ||
          (resource.data.author.id == request.auth.uid || isOrgAdminOrOwner(orgId))
        );
        allow delete: if isAuthenticated() && (resource.data.author.id == request.auth.uid || isOrgAdminOrOwner(orgId));
        
        match /comments/{commentId} {
            allow read: if isAuthenticated() && isOrgMember(orgId);
            allow create: if isAuthenticated() && isOrgMember(orgId);
            allow update, delete: if isAuthenticated() && (resource.data.author.id == request.auth.uid || isOrgAdminOrOwner(orgId));
        }
      }
    }

    // --- Authenticated Resource Rules ---

    match /users/{userId} {
      allow read: if isAuthenticated(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAuthenticated();
      allow delete: if isOwner(userId);

      match /orgSettings/{orgId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /projects/{projectId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg() && isOrgAdminOrOwner(resource.data.orgId);
    }
    
    function isOrgStaffOrHigher(orgId) {
      let role = getMemberRole(orgId);
      return isAuthenticated() && (
        role == "Owner" || 
        role == "Admin" || 
        role == "Manager" || 
        role == "Accountant" || 
        role == "Staff"
      );
    }

    match /tasks/{taskId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }

    match /works/{workId} {
      allow read: if isAuthenticated() && isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && isOrgStaffOrHigher(request.resource.data.orgId);
      allow update: if isAuthenticated() && isOrgStaffOrHigher(resource.data.orgId);
      allow delete: if isAuthenticated() && isOrgStaffOrHigher(resource.data.orgId);
    }

    match /incomes/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }

    match /expenses/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }
    
    match /customers/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }
    
    match /vendors/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }

    match /files/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }
    
    match /contracts/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }
    
    match /workers/{docId} {
      allow read: if resourceBelongsToUserOrg();
      allow create: if requestBelongsToUserOrg();
      allow update: if resourceBelongsToUserOrg();
      allow delete: if resourceBelongsToUserOrg();
    }

    match /notifications/{notificationId} {
      allow read: if resourceBelongsToUserOrg(); 
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && request.auth.uid == (resource.data.userId || resource.data.createdBy);
    }

    match /game_scores/{scoreId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    match /activities/{activityId} {
        allow read: if resourceBelongsToUserOrg();
        allow create: if requestBelongsToUserOrg();
    }

    match /join_requests/{requestId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOrgMember(resource.data.orgId));
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOrgOwner(resource.data.orgId));
    }

    match /chat_threads/{threadId} {
        allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
        
        match /messages/{messageId} {
            allow read, write: if isAuthenticated() && (
               request.auth.uid in get(/databases/$(database)/documents/chat_threads/$(threadId)).data.participants
            );
        }
    }

    match /integrations/{docId} {
      allow read: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.organizationId);
      allow update: if isAuthenticated() && isOrgMember(resource.data.organizationId);
      allow delete: if isAuthenticated() && isOrgMember(resource.data.organizationId);
    }
  }
}
