rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Default: Deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow users to update their own profile and create their own document
      allow create, update: if isOwner(userId);
      // Allow specialized delete logic (e.g. cloud functions) or owner delete
      allow delete: if isOwner(userId); 
    }

    // Organizations (Teams)
    match /organizations/{orgId} {
      allow read: if isAuthenticated(); // Refine: check if user is in 'members' array
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Refine: check if user is admin
      allow delete: if isAuthenticated(); // Refine: check if user is owner
    }

    // Projects
    match /projects/{projectId} {
      allow read, write: if isAuthenticated(); // Simplify for now, ideally check org membership
    }
    
    // Activities
    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    // Customers, Incomes, Expenses - access via Org
    match /customers/{docId} { allow read, write: if isAuthenticated(); }
    match /incomes/{docId} { allow read, write: if isAuthenticated(); }
    match /expenses/{docId} { allow read, write: if isAuthenticated(); }
    match /files/{docId} { allow read, write: if isAuthenticated(); }
    match /tasks/{docId} { allow read, write: if isAuthenticated(); }
    match /vendors/{docId} { allow read, write: if isAuthenticated(); }
    match /wages/{docId} { allow read, write: if isAuthenticated(); }
  }
}
